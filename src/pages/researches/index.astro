---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import { researches as allResearches } from '../../data/researches';

const researches = allResearches.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
const tags = ['All', ...new Set(researches.map(b => b.tag))];
---

<Layout
  title="Security Research & Field Notes | Priyansh Khandal"
  description="Technical research writeups on firmware extraction, binary disassembly, AI red-teaming, smart contract vulnerabilities, and NixOS OPSEC."
>
  <Header currentPath="/researches" />

  <main class="researches-page">
    <div class="site-container">
      <!-- Page Header -->
      <div class="page-header reveal d1">
        <div class="eyebrow-chip">
          <span class="prompt-symbol">&gt;</span>
          <span>~/research_disclosures</span>
        </div>
        <h1 class="page-title">Technical Field Notes &amp; Disclosures</h1>
        <p class="page-sub">
          {researches.length} published research articles covering vulnerability analysis, AI model security, and binary forensics.
        </p>
      </div>

      <!-- Filters Bar -->
      <div class="filters-bar reveal d2" id="filters">
        {tags.map(tag => (
          <button
            class={`filter-btn ${tag === 'All' ? 'active' : ''}`}
            data-tag={tag}
            type="button"
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Research Grid (2-Column Technical Grid) -->
      <div class="researches-grid reveal d3" id="researchesGrid">
        {researches.map(research => (
          <a
            href={`/researches/${research.slug}`}
            class="research-card"
            data-tag={research.tag}
          >
            <div class="card-top-row">
              <span class="tag-chip">[{research.tag}]</span>
              <span class="meta-chip">{research.date} · {research.readTime} read</span>
            </div>

            <h2 class="card-title">{research.title}</h2>
            <p class="card-excerpt">{research.excerpt}</p>

            <div class="card-footer-row">
              <span class="read-label">Read Full Disclosure</span>
              <span class="read-arrow">→</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div class="empty-state" id="emptyState" style="display:none;">
        <span class="status-dot" style="background:var(--status-warning);" aria-hidden="true"></span>
        <p>No research disclosures found matching active filter.</p>
        <button class="btn-secondary" id="resetFilterBtn" type="button">Reset Filters</button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .researches-page {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    width: fit-content;
  }

  .prompt-symbol {
    font-weight: 700;
  }

  .page-title {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    color: var(--text-primary);
  }

  .page-sub {
    font-size: 0.95rem;
    color: var(--text-secondary);
    max-width: 640px;
    line-height: 1.6;
  }

  /* ── Filter Controls ── */
  .filters-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .filter-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
    border-color: var(--border-active);
  }
  .filter-btn.active {
    color: var(--accent-sky);
    background-color: var(--bg-elevated);
    border-color: var(--accent-sky);
  }

  /* ── 2-Column Grid ── */
  .researches-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .research-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .research-card:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-sage);
    padding: 2px 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
  }

  .meta-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.35;
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .card-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .research-card:hover .read-label {
    color: var(--accent-sky);
  }
  .research-card:hover .read-arrow {
    color: var(--accent-sky);
    transform: translateX(2px);
  }

  .read-arrow {
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .empty-state {
    padding: 3rem 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .researches-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.research-card');
  const empty = document.getElementById('emptyState') as HTMLElement | null;
  const resetBtn = document.getElementById('resetFilterBtn') as HTMLButtonElement | null;

  function setFilter(tag: string) {
    filterBtns.forEach(b => b.classList.toggle('active', b.dataset.tag === tag));
    let visibleCount = 0;
    cards.forEach(card => {
      const match = tag === 'All' || card.dataset.tag === tag;
      card.style.display = match ? 'flex' : 'none';
      if (match) visibleCount++;
    });
    if (empty) {
      empty.style.display = visibleCount === 0 ? 'flex' : 'none';
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag || 'All';
      setFilter(tag);
    });
  });

  resetBtn?.addEventListener('click', () => {
    setFilter('All');
  });
</script>

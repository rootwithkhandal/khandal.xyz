---
import '../styles/tokens.css';
import '../styles/dot-grid.css';
import '../styles/global.css';
import DotGrid from '../components/common/DotGrid.astro';
import SoundManager from '../components/common/SoundManager.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const siteUrl = 'https://khandal.tech';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const defaultCanonical = currentPath === '/' ? siteUrl : `${siteUrl}${currentPath}`;

const {
  title = 'Priyansh Khandal · SOC Analyst & Security Researcher',
  description = 'Priyansh Khandal: MCA graduate student and Certified SOC Analyst (CSA) specializing in SIEM telemetry, Sigma detection engineering, digital forensics, and blue team operations.',
  canonical = defaultCanonical,
  extraSchema,
} = Astro.props;

const ogImage = `${siteUrl}/profile.png`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Priyansh Khandal",
  "alternateName": ["rootwithkhandal"],
  "url": siteUrl,
  "email": "mailto:ipriyansh@outlook.in",
  "image": ogImage,
  "jobTitle": "SOC Analyst & Detection Engineer",
  "description": description,
  "sameAs": [
    "https://github.com/rootwithkhandal",
    "https://linkedin.com/in/priyanshkhandal",
    "https://tryhackme.com/p/rootwithkhandal"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "Certified SOC Analyst (CSA)",
      "credentialCategory": "Professional Certification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "EC-Council"
      }
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "IBM Cybersecurity Analyst Professional Certificate",
      "credentialCategory": "Professional Certificate",
      "recognizedBy": {
        "@type": "Organization",
        "name": "IBM"
      }
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "Google Cybersecurity Professional Certificate",
      "credentialCategory": "Professional Certificate",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Google"
      }
    }
  ],
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Master of Computer Applications (MCA)"
  },
  "knowsAbout": [
    { "@type": "DefinedTerm", "name": "Security Operations Center (SOC)" },
    { "@type": "DefinedTerm", "name": "SIEM Correlation (Splunk, Elastic, Wazuh)" },
    { "@type": "DefinedTerm", "name": "Detection Engineering & Sigma Rules" },
    { "@type": "DefinedTerm", "name": "Digital Forensics & Memory Analysis (Volatility 3)" },
    { "@type": "DefinedTerm", "name": "Threat Hunting & MITRE ATT&CK" },
    { "@type": "DefinedTerm", "name": "Blue Team Operations & Incident Triage" },
    { "@type": "DefinedTerm", "name": "Sysmon & Windows Security Event Logs (EVTX)" },
    { "@type": "DefinedTerm", "name": "SecOps Automation with Python & PowerShell" }
  ]
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${siteUrl}/#profilepage`,
  "url": canonical,
  "name": title,
  "description": description,
  "mainEntity": { "@id": `${siteUrl}/#person` },
  "dateCreated": "2026-01-01T00:00:00Z",
  "dateModified": new Date().toISOString()
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Priyansh Khandal · SOC Analyst Portfolio",
  "description": "SOC analyst portfolio, detection engineering labs, SIEM telemetry correlation, and blue team security research by Priyansh Khandal.",
  "publisher": { "@id": `${siteUrl}/#person` },
  "inLanguage": "en-US"
};

const schemas: Record<string, unknown>[] = [personSchema, profilePageSchema, websiteSchema];
if (extraSchema) {
  if (Array.isArray(extraSchema)) {
    schemas.push(...extraSchema);
  } else {
    schemas.push(extraSchema);
  }
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Priyansh Khandal" />
  <meta name="keywords" content="Priyansh Khandal, SOC Analyst, Certified SOC Analyst, EC-Council CSA, Detection Engineer, Blue Team, SIEM, Splunk, Wazuh, Sysmon, Sigma Rules, Digital Forensics, Volatility 3, Incident Response, Cybersecurity Portfolio, MCA Graduate" />
  <link rel="canonical" href={canonical} />

  <!-- GEO Optimization (Generative & Search Geo Targeting) -->
  <meta name="geo.region" content="IN" />
  <meta name="geo.placename" content="India" />

  <!-- Discovery for LLMs / AI Search Engines (AEO / GEO) -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Manifest" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="Priyansh Khandal - SOC Analyst & Detection Engineer" />
  <meta property="og:site_name" content="Priyansh Khandal" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Priyansh Khandal - SOC Analyst & Detection Engineer" />

  <!-- Structured data (JSON-LD) -->
  {schemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Robots & Chrome Theme -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="theme-color" content="#121316" />

  <!-- Favicon Suite -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />

  <!-- Typography: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <DotGrid />
  <SoundManager />
  <slot />

  <script>
    // Universal scroll-triggered reveal
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('visible'));
    }
  </script>
</body>
</html>

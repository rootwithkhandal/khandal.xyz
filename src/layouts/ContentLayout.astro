---
import Layout from './Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  tag: string;
  tagColor?: string;
  meta: string;
  backHref: string;
  backLabel: string;
  externalUrl?: string;
  externalLabel?: string;
  htmlContent: string;
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title, tag, meta,
  backHref, backLabel,
  externalUrl, externalLabel,
  htmlContent,
  extraSchema,
} = Astro.props;
---

<Layout title={`${title} | Priyansh Khandal`} extraSchema={extraSchema}>
  <Header />

  <main class="content-post-main">
    <div class="site-container">
      <div class="post-nav-bar">
        <a href={backHref} class="btn-ghost back-action-btn">
          <span class="back-arrow">&lt;</span>
          <span>{backLabel}</span>
        </a>

        {externalUrl && externalLabel && (
          <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary external-action-btn">
            <span>{externalLabel}</span>
            <span class="ext-arrow">↗</span>
          </a>
        )}
      </div>

      <!-- Article Header -->
      <header class="post-header-card">
        <div class="post-meta-top">
          <span class="post-tag">[{tag}]</span>
          <span class="post-meta-text">{meta}</span>
        </div>
        <h1 class="post-title-text">{title}</h1>
      </header>

      <!-- Prose Content -->
      <article class="prose-body" set:html={htmlContent} />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .content-post-main {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    min-height: 70vh;
  }

  .post-nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-action-btn, .external-action-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    min-height: 32px;
  }

  .back-arrow, .ext-arrow {
    color: var(--accent-sky);
  }

  /* ── Post Header Card ── */
  .post-header-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 2px 6px;
  }

  .post-meta-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-title-text {
    font-size: clamp(1.8rem, 1.4rem + 1.5vw, 2.75rem);
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* ── Prose Typography & Code Discipline ── */
  .prose-body {
    max-width: 820px;
    margin: 0 auto;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .prose-body h1, .prose-body h2, .prose-body h3, .prose-body h4 {
    color: var(--text-primary);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .prose-body h2 {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .prose-body h3 {
    font-size: clamp(1.1rem, 0.95rem + 0.4vw, 1.35rem);
  }

  .prose-body p {
    margin-bottom: 1.25rem;
  }

  .prose-body a {
    color: var(--accent-sky);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }
  .prose-body a:hover {
    color: var(--accent-hover);
  }

  .prose-body code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.15rem 0.35rem;
    color: var(--accent-sky);
  }

  .prose-body pre {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose-body pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--text-primary);
  }

  /* Card blockquote adhering to no-left-stripe rule */
  .prose-body blockquote {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: normal;
  }

  .prose-body ul, .prose-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose-body li {
    margin-bottom: 0.35rem;
  }

  .prose-body hr {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2.5rem 0;
  }

  .prose-body img {
    max-width: 100%;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-subtle);
    margin: 1.5rem 0;
  }

  .prose-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.85rem;
  }

  .prose-body th, .prose-body td {
    padding: 0.65rem 1rem;
    border: 1px solid var(--border-subtle);
    text-align: left;
  }

  .prose-body th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    background-color: var(--bg-surface);
  }
</style>

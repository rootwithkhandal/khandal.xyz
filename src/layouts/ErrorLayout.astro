---
import '../styles/tokens.css';
import '../styles/dot-grid.css';
import '../styles/global.css';
import DotGrid from '../components/common/DotGrid.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  code: number;
  title: string;
  message: string;
  hint: string;
}

const { code, title, message, hint } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{code} · {title} | Priyansh Khandal</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <DotGrid />
  <Header />

  <main class="error-main">
    <div class="site-container">
      <div class="error-diagnostic-panel">
        <div class="panel-header">
          <div class="diagnostic-tag">
            <span class="status-dot" style="background:var(--status-error);" aria-hidden="true"></span>
            <span>SYSTEM_EXCEPTION :: STATUS_{code}</span>
          </div>
          <span class="exit-code">EXIT CODE {code}</span>
        </div>

        <div class="panel-body">
          <div class="code-banner">{code}</div>
          <h1 class="error-heading">{title}</h1>
          <p class="error-message">{message}</p>
          <div class="error-hint-box">
            <span class="hint-prefix">&gt; DIAGNOSTIC:</span>
            <span class="hint-text">{hint}</span>
          </div>

          <div class="error-actions">
            <a href="/" class="btn-primary">
              [ ↵ Return to Terminal ]
            </a>
            <a href="/projects" class="btn-secondary">
              Inspect Projects
            </a>
            <a href="/researches" class="btn-ghost">
              Read Researches
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .error-main {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .error-diagnostic-panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    max-width: 680px;
    margin: 0 auto;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background-color: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .diagnostic-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--status-error);
  }

  .exit-code {
    color: var(--text-muted);
  }

  .panel-body {
    padding: 2.5rem clamp(1.5rem, 5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: center;
    align-items: center;
  }

  .code-banner {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    color: var(--status-error);
    line-height: 1;
    opacity: 0.9;
  }

  .error-heading {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.85rem);
    color: var(--text-primary);
  }

  .error-message {
    font-size: 0.925rem;
    color: var(--text-secondary);
    max-width: 480px;
    line-height: 1.6;
  }

  .error-hint-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.65rem 1rem;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.775rem;
    max-width: 100%;
  }

  .hint-prefix {
    color: var(--accent-sky);
  }

  .hint-text {
    color: var(--text-muted);
  }

  .error-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>

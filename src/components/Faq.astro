---
export const faqs = [
  {
    question: "Who is Priyansh Khandal?",
    answer: "Priyansh Khandal is an MCA graduate student and Certified SOC Analyst (CSA) specializing in blue team defense, SIEM telemetry correlation, Sigma rule authoring, and digital forensics."
  },
  {
    question: "What roles is Priyansh actively targeting?",
    answer: "Entry-level to junior SOC Analyst (L1/L2), Detection Engineer Intern/Associate, and Junior Incident Responder roles across 24/7 rotational shifts — remote, hybrid, or on-site."
  },
  {
    question: "What certifications does Priyansh hold?",
    answer: "EC-Council Certified SOC Analyst (CSA), IBM Cybersecurity Analyst Professional Certificate, Google Cybersecurity Professional Certificate, and active top-ranked Blue Team track achievements on TryHackMe."
  },
  {
    question: "What hands-on lab experience does Priyansh bring?",
    answer: "A virtualized enterprise SOC home lab with Splunk Enterprise, Wazuh EDR, and Sysmon log pipelines. Active investigations on TryHackMe and Hack The Box, plus custom Sigma and YARA rules targeting adversary persistence and privilege escalation."
  },
  {
    question: "Where can SOC labs and detection rules be reviewed?",
    answer: "SOC labs and detection tools are published under Projects (/projects), technical writeups are under Researches (/researches), and open-source detection rules are available on GitHub (github.com/rootwithkhandal)."
  },
  {
    question: "How can recruiters and security teams contact Priyansh?",
    answer: "Direct inquiries can be sent to khandakp04@gmail.com or via LinkedIn (linkedin.com/in/priyanshkhandal). Available immediately for full-time SOC roles with 0-day notice."
  }
];

export const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="faq-section">
  <div class="site-container">
    <div class="faq-layout">
      <!-- Left: Header -->
      <div class="faq-header reveal d1">
        <div class="eyebrow-chip">
          <span class="prompt-symbol">&gt;</span>
          <span>~/faq</span>
        </div>
        <h2 class="section-title">Frequently Asked</h2>
        <p class="section-sub">
          Background, competencies, and availability for hiring managers and recruiters.
        </p>
      </div>

      <!-- Right: Accordion -->
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item reveal d2" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <span class="faq-marker" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-subtle);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .faq-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    width: fit-content;
  }

  .prompt-symbol {
    font-weight: 700;
  }

  .section-title {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem);
    color: var(--text-primary);
  }

  .section-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
    max-width: 320px;
    line-height: 1.55;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .faq-item[open] {
    border-color: var(--border-active);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
    min-height: var(--touch-target-min);
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question:hover {
    color: var(--accent-sky);
    background-color: var(--bg-hover);
  }

  .faq-marker {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .faq-item[open] .faq-marker {
    transform: rotate(45deg);
    color: var(--accent-sky);
  }

  .faq-answer {
    padding: 0 1.1rem 1.1rem 1.1rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.6;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
  }

  @media (max-width: 768px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .faq-header {
      position: static;
    }
  }
</style>

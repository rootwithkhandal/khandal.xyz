---
import { projects } from '../data/projects';

// Show only first 6 on homepage
const displayProjects = projects.slice(0, 6);
---

<section id="projects" class="projects-section">
  <div class="site-container">
    <div class="section-header reveal d1">
      <div class="header-left">
        <div class="eyebrow-chip">
          <span class="prompt-symbol">&gt;</span>
          <span>~/active_operations</span>
        </div>
        <h2 class="section-title">SOC Labs &amp; Detection Tools</h2>
      </div>
      <div class="header-right">
        <a href="/projects" class="btn-secondary view-all-btn">
          <span>All Projects →</span>
        </a>
      </div>
    </div>

    <!-- 3-Column Project Grid for 6 items -->
    <div class="projects-grid">
      {displayProjects.map((project, i) => (
        <a
          href={`/projects/${project.slug}`}
          class={`project-module reveal d${(i % 3) + 2}`}
        >
          <div class="module-top">
            <span class="module-tag" style={`color: ${project.tagColor}; border-color: ${project.tagColor}33;`}>{project.tag}</span>
          </div>

          <h3 class="module-title">{project.title}</h3>
          <p class="module-excerpt">{project.excerpt}</p>

          <div class="module-footer">
            <span class="module-repo">{project.githubRepo}</span>
            <span class="action-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    width: fit-content;
  }

  .prompt-symbol {
    font-weight: 700;
  }

  .section-title {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem);
    color: var(--text-primary);
  }

  .view-all-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 0.85rem;
  }

  /* ── 3-Column Projects Grid ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .project-module {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .project-module:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .module-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .module-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 2px 7px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .module-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }

  .module-excerpt {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .module-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .module-repo {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-module:hover .module-footer {
    color: var(--accent-sky);
  }
  .project-module:hover .action-arrow {
    transform: translateX(3px);
  }

  .action-arrow {
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

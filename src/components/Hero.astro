---
import HeroTerminal from './home/HeroTerminal.astro';
---

<section id="hero" class="hero-section">
  <div class="site-container">
    <div class="hero-grid">
      <!-- Left: Value Proposition & Scope -->
      <div class="hero-content">
        <div class="eyebrow-chip reveal d1">
          <span class="status-dot pulse" aria-hidden="true"></span>
          <span>BLUE TEAM · DETECTION · SOC OPERATIONS</span>
        </div>

        <h1 class="hero-heading reveal d2">
          SOC Analyst &amp; Detection Engineer
        </h1>

        <p class="hero-description reveal d3">
          MCA student and EC-Council Certified SOC Analyst building real-world detection pipelines, triage automation, and incident response playbooks. Open to L1/L2 SOC Analyst roles.
        </p>

        <div class="hero-actions reveal d4">
          <a href="/#contact" class="btn-primary hero-cta">
            <span>Connect for Roles</span>
          </a>
          <a href="/projects" class="btn-secondary hero-secondary">
            <span>View SOC Labs</span>
          </a>
        </div>

        <!-- Credential Strip -->
        <div class="hero-credentials reveal d5">
          <div class="cred-chip">
            <span class="cred-icon">▪</span>
            <span>EC-Council CSA</span>
          </div>
          <div class="cred-chip">
            <span class="cred-icon">▪</span>
            <span>Splunk · Wazuh · Sigma</span>
          </div>
          <div class="cred-chip">
            <span class="cred-icon">▪</span>
            <span>MCA Candidate</span>
          </div>
        </div>
      </div>

      <!-- Right: Real Interactive Developer Terminal -->
      <div class="hero-terminal-wrap reveal d3">
        <HeroTerminal />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--accent-sky);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    width: fit-content;
  }

  .hero-heading {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1.8rem + 2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-description {
    font-size: clamp(0.9rem, 0.82rem + 0.3vw, 1rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .hero-cta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.6rem 1.15rem;
  }

  .hero-secondary {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.6rem 1.15rem;
  }

  /* Credential Strip — horizontal chip row replacing old metric grid */
  .hero-credentials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .cred-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary);
    padding: 4px 10px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
  }

  .cred-icon {
    color: var(--accent-sky);
    font-size: 0.5rem;
  }

  .hero-terminal-wrap {
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-content {
      max-width: 100%;
    }
  }
</style>

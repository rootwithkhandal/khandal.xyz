---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Col 1: Identity & Prompt -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <span class="prompt-symbol">&gt;</span>
          <span class="prompt-text">priyansh@khandal:~$</span>
        </div>
        <p class="footer-bio">
          Priyansh Khandal: MCA student and Certified SOC Analyst (CSA). Specializing in SIEM telemetry, Sigma detection engineering, incident triage, and digital forensics.
        </p>
        <div class="footer-telemetry">
          <span class="status-dot pulse" aria-hidden="true"></span>
          <span>Zero tracking · Edge isolated</span>
        </div>
      </div>

      <!-- Col 2: Navigation Lanes -->
      <div class="footer-col">
        <h4 class="col-title">WORKSPACE</h4>
        <ul class="footer-links">
          <li><a href="/">~/home</a></li>
          <li><a href="/projects">~/projects</a></li>
          <li><a href="/researches">~/researches</a></li>
          <li><a href="/#contact">~/contact</a></li>
          <li><a href="/security">~/security_policy</a></li>
        </ul>
      </div>

      <!-- Col 3: Security & Contact Desk -->
      <div class="footer-col">
        <h4 class="col-title">SECURITY &amp; TRUST</h4>
        <ul class="footer-links">
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/tos">Terms of Service</a></li>
          <li><a href="/cookie-policy">Cookie Policy</a></li>
          <li><a href="/security#disclosure">Vulnerability Disclosure</a></li>
          <li>
            <a href="mailto:khandakp04@gmail.com" class="email-link">khandakp04@gmail.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Meta Row -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <span>re.khandal.cc · khandal.tech</span>
        <span class="sep">/</span>
        <span>© {currentYear} Priyansh Khandal</span>
      </div>
      <div class="bottom-right">
        <span class="pgp-chip">PGP: 4A8F 92E1 0D3C B8A7</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    margin-top: 2rem;
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .prompt-symbol {
    color: var(--accent-sky);
    font-weight: 700;
  }

  .footer-bio {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 420px;
  }

  .footer-telemetry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }
  .footer-links a:hover {
    color: var(--accent-sky);
  }

  .email-link {
    color: var(--accent-sky) !important;
  }

  /* Bottom Row */
  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .bottom-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sep {
    color: var(--border-subtle);
  }

  .pgp-chip {
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

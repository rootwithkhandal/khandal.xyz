---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/#profile', label: 'About' },
  { href: '/projects', label: 'SOC Labs & Tools' },
  { href: '/researches', label: 'Researches' },
  { href: '/security', label: 'Security' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <!-- Left: Brand / Monospace Prompt -->
    <div class="brand-zone">
      <a href="/" class="brand-link" aria-label="Priyansh Khandal Homepage">
        <span class="prompt-symbol">&gt;</span>
        <span class="prompt-text">priyansh@khandal:~$</span>
      </a>
      <div class="status-badge" title="Status: Active MCA Student · Open to SOC Analyst Roles & Internships">
        <span class="status-dot pulse" aria-hidden="true"></span>
        <span class="status-text">open for roles</span>
      </div>
    </div>

    <!-- Center: Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== '/' && href !== '/#contact' && href !== '/#profile' && currentPath.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class={`nav-item ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Right: Action CTA & Mobile Toggle -->
    <div class="actions-zone">
      <a href="/#contact" class="btn-primary hire-btn">
        <span>Connect</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        class="mobile-toggle"
        id="mobileToggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="drawer-backdrop" id="drawerBackdrop" aria-hidden="true"></div>
<aside
  class="mobile-drawer"
  id="mobileDrawer"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <div class="drawer-header">
    <span class="drawer-title">&gt; navigation_menu</span>
    <button
      class="drawer-close"
      id="drawerClose"
      type="button"
      aria-label="Close navigation menu"
    >
      [ Esc ]
    </button>
  </div>

  <nav class="drawer-nav">
    <ul class="drawer-list">
      <li>
        <a href="/" class="drawer-item">
          <span class="item-prefix">~/</span> Home
        </a>
      </li>
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="drawer-item">
            <span class="item-prefix">~/</span> {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="drawer-footer">
    <div class="drawer-status">
      <span class="status-dot pulse" aria-hidden="true"></span>
      <span class="drawer-status-text">Platform Online · 0 Flaws</span>
    </div>
    <a href="/#contact" class="btn-primary drawer-cta" id="drawerCta">
      Connect / Contact
    </a>
  </div>
</aside>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 100;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ── Brand Zone ── */
  .brand-zone {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: 4px 6px;
    border-radius: var(--radius-xs);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .brand-link:hover {
    color: var(--accent-sky);
    border-color: var(--border-subtle);
    background-color: var(--bg-elevated);
  }

  .prompt-symbol {
    color: var(--accent-sky);
    font-weight: 700;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-sage);
    letter-spacing: 0.04em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  /* ── Desktop Navigation ── */
  .desktop-nav {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .nav-item {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-xs);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .nav-item:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
    border-color: var(--border-subtle);
  }
  .nav-item.active {
    color: var(--accent-sky);
    background-color: var(--bg-elevated);
    border-color: var(--border-active);
  }

  /* ── Actions Zone ── */
  .actions-zone {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hire-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.85rem;
    min-height: 32px;
    white-space: nowrap;
  }

  /* ── Mobile Hamburger Toggle ── */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .mobile-toggle:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
  }

  .bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* ── Mobile Drawer ── */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(18, 19, 22, 0.75);
    backdrop-filter: blur(4px);
    z-index: 250;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .drawer-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: var(--bg-surface);
    border-left: 1px solid var(--border-subtle);
    z-index: 300;
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
  }
  .mobile-drawer.open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-elevated);
  }

  .drawer-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .drawer-close {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-sky);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: var(--radius-xs);
  }
  .drawer-close:hover {
    background-color: var(--bg-hover);
  }

  .drawer-nav {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
  }

  .drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    min-height: var(--touch-target-min);
    transition: all var(--transition-fast);
  }
  .drawer-item:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-active);
    color: var(--accent-sky);
  }

  .item-prefix {
    color: var(--accent-sky);
    font-size: 0.8rem;
  }

  .drawer-footer {
    padding: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawer-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .drawer-cta {
    width: 100%;
    min-height: var(--touch-target-min);
  }

  /* ── Responsive Rules ── */
  @media (max-width: 980px) {
    .status-badge {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .prompt-text {
      font-size: 0.78rem;
    }
    .hire-btn {
      display: none;
    }
  }
</style>

<script>
  // Mobile drawer keyboard and focus management
  const mobileToggle = document.getElementById('mobileToggle') as HTMLButtonElement | null;
  const drawerBackdrop = document.getElementById('drawerBackdrop') as HTMLElement | null;
  const mobileDrawer = document.getElementById('mobileDrawer') as HTMLElement | null;
  const drawerClose = document.getElementById('drawerClose') as HTMLButtonElement | null;

  function openDrawer() {
    if (!mobileDrawer || !drawerBackdrop || !mobileToggle) return;
    mobileDrawer.classList.add('open');
    drawerBackdrop.classList.add('open');
    mobileDrawer.setAttribute('aria-hidden', 'false');
    drawerBackdrop.setAttribute('aria-hidden', 'false');
    mobileToggle.setAttribute('aria-expanded', 'true');
    drawerClose?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!mobileDrawer || !drawerBackdrop || !mobileToggle) return;
    mobileDrawer.classList.remove('open');
    drawerBackdrop.classList.remove('open');
    mobileDrawer.setAttribute('aria-hidden', 'true');
    drawerBackdrop.setAttribute('aria-hidden', 'true');
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileToggle.focus();
    document.body.style.overflow = '';
  }

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileDrawer?.classList.contains('open');
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  drawerClose?.addEventListener('click', closeDrawer);
  drawerBackdrop?.addEventListener('click', closeDrawer);

  // Close drawer on link click
  const drawerLinks = mobileDrawer?.querySelectorAll('a');
  drawerLinks?.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  // Escape key handler
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>

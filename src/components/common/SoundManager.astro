<script>
  // ── Procedural Web Audio Synthesizer (0 KB external bandwidth, 100% Cloudflare Free Tier safe) ──
  class CyberAudioEngine {
    private ctx: AudioContext | null = null;
    public isEnabled: boolean = true;
    private masterGain: GainNode | null = null;
    private readonly SYSTEM_VOLUME = 0.50; // 50% of system volume strictly

    constructor() {
      // Sound enabled by default as requested; persists mute preference if explicitly set to 'false'
      const stored = localStorage.getItem('sfx_v2');
      this.isEnabled = stored === null ? true : stored === 'true';

      this.initEventListeners();
    }

    private getContext(): AudioContext | null {
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) {
          this.ctx = new AudioCtx();
        }
      }
      if (this.ctx) {
        if (!this.masterGain) {
          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(this.SYSTEM_VOLUME, this.ctx.currentTime);
          this.masterGain.connect(this.ctx.destination);
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      return this.ctx;
    }

    // ── 1. Tactile Micro Mouse Click (Strict 50% system volume ceiling) ──
    public playClick() {
      if (!this.isEnabled) return;
      const ctx = this.getContext();
      if (!ctx || !this.masterGain) return;

      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      // Crisp tactile micro snap
      osc.frequency.setValueAtTime(1200 + Math.random() * 180, now);
      osc.frequency.exponentialRampToValueAtTime(70, now + 0.02);

      gain.gain.setValueAtTime(0.75, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.022);

      osc.connect(gain);
      gain.connect(this.masterGain);

      osc.start(now);
      osc.stop(now + 0.025);
    }

    // ── 2. Mechanical Typewriter Keystroke (Strict 50% system volume ceiling) ──
    public playTypewriter(isSpecial: boolean = false) {
      if (!this.isEnabled) return;
      const ctx = this.getContext();
      if (!ctx || !this.masterGain) return;

      const now = ctx.currentTime;

      // Primary mechanical clack (randomized pitch so every key press sounds unique)
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const baseFreq = isSpecial ? 540 : 1300 + (Math.random() * 300 - 150);

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(baseFreq, now);
      osc.frequency.exponentialRampToValueAtTime(150, now + (isSpecial ? 0.045 : 0.028));

      gain.gain.setValueAtTime(isSpecial ? 0.85 : 0.65, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + (isSpecial ? 0.05 : 0.032));

      osc.connect(gain);
      gain.connect(this.masterGain);
      osc.start(now);
      osc.stop(now + 0.055);

      // Micro noise burst simulating mechanical platen impact
      const bufferSize = Math.floor(ctx.sampleRate * 0.018);
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.35));
      }

      const noise = ctx.createBufferSource();
      noise.buffer = buffer;

      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = isSpecial ? 900 : 2400;

      const noiseGain = ctx.createGain();
      noiseGain.gain.setValueAtTime(0.5, now);
      noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.02);

      noise.connect(filter);
      filter.connect(noiseGain);
      noiseGain.connect(this.masterGain);

      noise.start(now);
      noise.stop(now + 0.024);
    }

    // ── Toggle Sound On/Off (Shortcut: M) ──
    public toggle() {
      this.isEnabled = !this.isEnabled;
      localStorage.setItem('sfx_v2', this.isEnabled ? 'true' : 'false');
      localStorage.setItem('sfx_enabled', this.isEnabled ? 'true' : 'false');

      if (this.isEnabled) {
        this.playClick();
      }
    }

    private initEventListeners() {
      // 1. Mouse Click Listener - plays tactile micro click on mouse clicks
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        // Skip if target was a toggle button
        if (target.closest('.sound-toggle-btn')) return;

        this.playClick();
      }, { passive: true });

      // 2. Keyboard Typewriter Listener - plays typewriter sound on typing
      document.addEventListener('keydown', (e) => {
        const activeTag = document.activeElement?.tagName?.toLowerCase();
        const isInputField = activeTag === 'input' || activeTag === 'textarea';

        // Keyboard Shortcut 'M' toggles sound when not typing inside an input
        if ((e.key === 'm' || e.key === 'M') && !isInputField && !e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          this.toggle();
          return;
        }

        // If sound enabled, play typewriter sound on typing
        if (!this.isEnabled) return;

        // Special keys: Enter, Space, Backspace, Tab
        const isSpecialKey = e.key === 'Enter' || e.key === 'Backspace' || e.key === ' ' || e.key === 'Tab';

        // Ignored modifier keys
        const isModifier = ['Shift', 'Control', 'Alt', 'Meta', 'CapsLock', 'Escape', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key);

        if (!isModifier) {
          this.playTypewriter(isSpecialKey);
        }
      }, { passive: false });

      // 3. Audio toggle button clicks (if any rendered)
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('.sound-toggle-btn')) {
          this.toggle();
        }
      });
    }
  }

  // Initialize once on DOM load
  if (typeof window !== 'undefined') {
    const audioEngine = new CyberAudioEngine();
    (window as unknown as { __cyberAudio: CyberAudioEngine }).__cyberAudio = audioEngine;
  }
</script>

---
const competencies = [
  {
    id: '01',
    category: 'SIEM & Telemetry',
    title: 'SIEM Architecture & Log Correlation',
    desc: 'Ingesting and correlating host telemetry, Windows Security Event Logs (EID 1, 3, 10, 4624, 4625), and Linux auditd logs for multi-source triage and alert fidelity.',
    tools: ['Splunk Enterprise', 'Elastic Security', 'Wazuh EDR', 'Sysmon EID'],
    icon: 'radar'
  },
  {
    id: '02',
    category: 'Detection Engineering',
    title: 'Detection Engineering & Threat Hunting',
    desc: 'Authoring vendor-agnostic Sigma rules mapped to MITRE ATT&CK techniques. Hunting unflagged persistence mechanisms, credential dumping, and lateral movement in enterprise logs.',
    tools: ['Sigma Rules', 'YARA', 'MITRE ATT&CK', 'Splunk SPL'],
    icon: 'target'
  },
  {
    id: '03',
    category: 'Incident Response',
    title: 'Incident Triage & Digital Forensics',
    desc: 'Rapid host triage, live memory dump analysis, process hollowing detection, network packet inspection, artifact timeline reconstruction, and containment playbooks.',
    tools: ['Volatility 3', 'KAPE', 'Wireshark', 'Zeek'],
    icon: 'search'
  },
  {
    id: '04',
    category: 'SecOps & Intel',
    title: 'SecOps Automation & Threat Intel',
    desc: 'Authoring triage automation scripts, IOC enrichment bots (VirusTotal, AbuseIPDB, Shodan), log normalization parsers, and custom detection test harnesses.',
    tools: ['Python', 'PowerShell', 'MISP', 'REST APIs'],
    icon: 'code'
  }
];

const credentials = [
  {
    name: 'Master of Computer Applications (MCA)',
    issuer: 'Active University Student · Systems & Cybersecurity',
    year: '2024 – Present',
    type: 'Degree Candidate',
    url: 'https://linkedin.com/in/priyanshkhandal',
  },
  {
    name: 'Certified SOC Analyst (CSA)',
    issuer: 'EC-Council',
    year: '2026',
    type: 'Industry Certification',
    url: 'https://www.eccouncil.org/programs/certified-soc-analyst-csa/',
  },
  {
    name: 'IBM Cybersecurity Analyst Certificate',
    issuer: 'IBM / Coursera',
    year: '2025',
    type: 'Professional Cert',
    url: 'https://www.coursera.org/professional-certificates/ibm-cybersecurity-analyst',
  },
  {
    name: 'SOC Level 1 Track',
    issuer: 'TryHackMe (Ranked Blue Team)',
    year: '2025',
    type: 'Ranked Practical Track',
    url: 'https://tryhackme.com/p/rootwithkhandal',
  },
  {
    name: 'Google Cybersecurity Certificate',
    issuer: 'Google Career Certificates',
    year: '2025',
    type: 'Professional Cert',
    url: 'https://grow.google/certificates/cybersecurity/',
  },
  {
    name: 'Cyber Defense & Threat Hunting Labs',
    issuer: 'Blue Team Labs / LetsDefend',
    year: '2025',
    type: 'Hands-on Labs',
    url: 'https://github.com/rootwithkhandal',
  },
];
---

<section id="profile" class="profile-section">
  <div class="site-container">
    <!-- Section Header -->
    <div class="section-header reveal d1">
      <div class="eyebrow-chip">
        <span class="prompt-symbol">&gt;</span>
        <span>~/soc_analyst_profile</span>
      </div>
      <h2 class="section-title">Core Competencies &amp; Credentials</h2>
      <p class="section-sub">
        Certified SOC Analyst and MCA student with hands-on lab experience across SIEM correlation, detection engineering, and digital forensics.
      </p>
    </div>

    <!-- 4 Core Competencies (2x2 Grid with integrated tools) -->
    <div class="competencies-grid">
      {competencies.map((item, i) => (
        <div class={`comp-card reveal d${(i % 2) + 2}`}>
          <div class="comp-top">
            <div class="comp-meta">
              <span class="comp-num">{item.id}</span>
              <span class="comp-category">{item.category}</span>
            </div>
            <div class="comp-icon" aria-hidden="true">
              {item.icon === 'radar' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 2a10 10 0 1 0 10 10"></path>
                  <path d="M12 6a6 6 0 1 0 6 6"></path>
                  <path d="M12 10a2 2 0 1 0 2 2"></path>
                  <path d="M12 12 21 3"></path>
                </svg>
              )}
              {item.icon === 'target' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="6"></circle>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
              )}
              {item.icon === 'search' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                  <path d="M11 8v6"></path>
                  <path d="M8 11h6"></path>
                </svg>
              )}
              {item.icon === 'code' && (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              )}
            </div>
          </div>

          <h3 class="comp-title">{item.title}</h3>
          <p class="comp-desc">{item.desc}</p>

          <!-- Integrated Tool Stack for this domain -->
          <div class="comp-tools">
            {item.tools.map(tool => (
              <span class="tool-chip">{tool}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Credentials & Education Group -->
    <div class="credentials-group reveal d4">
      <div class="group-header">
        <div class="group-title-row">
          <span class="group-badge">VERIFIED BACKGROUND</span>
          <h3 class="group-title">Education &amp; Credentials</h3>
        </div>
        <p class="group-desc">Formal university academics, vendor accreditations, and practical blue team lab completions.</p>
      </div>

      <div class="certs-grid">
        {credentials.map(cert => (
          <a
            href={cert.url}
            target="_blank"
            rel="noopener noreferrer"
            class="cert-card"
          >
            <div class="cert-top-row">
              <span class="cert-type">{cert.type}</span>
              <span class="cert-year">{cert.year}</span>
            </div>

            <h4 class="cert-name">{cert.name}</h4>
            <span class="cert-issuer">{cert.issuer}</span>

            <div class="cert-verify-link">
              <span>Verify Credential</span>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    width: fit-content;
  }
  .prompt-symbol {
    font-weight: 700;
  }

  .section-title {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem);
    color: var(--text-primary);
  }

  .section-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.6;
  }

  /* ── 4 Competency Cards (2x2 Grid) ── */
  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .comp-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    transition: all var(--transition-fast);
  }
  .comp-card:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .comp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .comp-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .comp-num {
    color: var(--accent-sky);
    font-weight: 600;
    padding: 2px 6px;
    background-color: var(--bg-elevated);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-subtle);
  }

  .comp-category {
    color: var(--text-muted);
  }

  .comp-icon {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comp-card:hover .comp-icon {
    color: var(--accent-sky);
  }

  .comp-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.35;
  }

  .comp-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .comp-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tool-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-secondary);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 2px 7px;
  }
  .comp-card:hover .tool-chip {
    border-color: var(--border-active);
    color: var(--text-primary);
  }

  /* ── Credentials Group ── */
  .credentials-group {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .group-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .group-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .group-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent-sage);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    padding: 2px 6px;
    letter-spacing: 0.04em;
  }

  .group-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .group-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  /* ── Certifications Grid (3 Columns) ── */
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .cert-card:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .cert-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .cert-type {
    color: var(--accent-sky);
  }

  .cert-year {
    color: var(--text-muted);
  }

  .cert-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.35;
  }

  .cert-issuer {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
    flex: 1;
  }

  .cert-verify-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    transition: color var(--transition-fast);
  }
  .cert-card:hover .cert-verify-link {
    color: var(--accent-sky);
  }
  .cert-verify-link svg {
    transition: transform var(--transition-fast);
  }
  .cert-card:hover .cert-verify-link svg {
    transform: translate(1px, -1px);
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .competencies-grid {
      grid-template-columns: 1fr;
    }
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

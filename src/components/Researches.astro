---
import { researches } from '../data/researches';

// Show first 6 on homepage
const displayResearches = researches.slice(0, 6);
---

<section id="researches" class="researches-section">
  <div class="site-container">
    <div class="section-header reveal d1">
      <div class="header-left">
        <div class="eyebrow-chip">
          <span class="prompt-symbol">&gt;</span>
          <span>~/field_notes</span>
        </div>
        <h2 class="section-title">Security Research &amp; Writeups</h2>
      </div>
      <div class="header-right">
        <a href="/researches" class="btn-secondary view-all-btn">
          <span>All Writeups →</span>
        </a>
      </div>
    </div>

    <!-- 3-Column Research Grid -->
    <div class="research-grid">
      {displayResearches.map((item, i) => (
        <a
          href={`/researches/${item.slug}`}
          class={`research-card reveal d${(i % 3) + 2}`}
        >
          <div class="card-meta-row">
            <span class="research-tag" style={`color: ${item.tagColor}; border-color: ${item.tagColor}33;`}>{item.tag}</span>
            <span class="research-time">{item.readTime}</span>
          </div>

          <h3 class="research-title">{item.title}</h3>
          <p class="research-excerpt">{item.excerpt}</p>

          <div class="card-footer">
            <span class="read-date">{item.date}</span>
            <span class="read-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .researches-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-sky);
    width: fit-content;
  }

  .prompt-symbol {
    font-weight: 700;
  }

  .section-title {
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.1rem);
    color: var(--text-primary);
  }

  .view-all-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 0.85rem;
  }

  /* ── 3-Column Research Grid ── */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .research-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .research-card:hover {
    border-color: var(--border-active);
    background-color: var(--bg-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .research-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 2px 7px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .research-time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .research-title {
    font-family: var(--font-sans);
    font-size: 1.025rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }

  .research-excerpt {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .research-card:hover .card-footer {
    color: var(--accent-sky);
  }
  .research-card:hover .read-arrow {
    transform: translateX(3px);
  }

  .read-arrow {
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  @media (max-width: 960px) {
    .research-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
